# Copy to backend/.env (never commit the real file).
# Exa: the agents' only web search source. Without a key the API serves labelled demo data.
EXA_API_KEY=
EXA_MODE=live                 # live | cache_only | mock
EXA_TOTAL_BUDGET_USD=40       # hard stop below the $50 credit
EXA_DAILY_BUDGET_USD=4
EXA_USER_DAILY_REQUESTS=60

# Cloudinary (rotation video, itinerary card, event teaser): cloudinary://<key>:<secret>@<cloud_name>
CLOUDINARY_URL=

# Optional: casual chat wording / request parsing / photo features (never a search source)
GEMINI_API_KEY=
MODEL_ID=gemini-2.0-flash

AGENT_NAME=Taimi
TEST_ACCOUNT_EMAIL=test@taimi.app
TEST_ACCOUNT_PASSWORD=taimi-demo-2026
# TAIMI_DB=backend/data/taimi.sqlite3
# CORS_ORIGINS=https://your-frontend.example
# COOKIE_SECURE=1             # behind HTTPS
